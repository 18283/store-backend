@startuml
skinparam style strictuml
skinparam handwritten false
skinparam shadowing false
skinparam backgroundColor #FFFFFF

skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11

skinparam linetype polyline

skinparam frameMargin 40
skinparam nodesep 150
skinparam ranksep 70

hide members
hide circle

skinparam class {
    BorderColor #000000
    BackgroundColor #FFFFFF
    HeaderBackgroundColor #FFFFFF
}

skinparam frame {
    BorderColor #000000
    BackgroundColor #FFFFFF
}

' Marco de Interacción UML 2.5 / 2.5.1
frame "sd CU29 Notificar estado del traspaso" {

    ' Nodos invisibles para márgenes
    class " " as espaciadorDerecha <<invisible>>
    hide espaciadorDerecha

    ' Líneas de vida UML 2.5
    class ":Sistema" as sys_sistema <<system>>
    class ":Cliente" as actor_cliente <<actor>>
    class ":InterfazNotificacion" as ui_notif <<boundary>>
    class ":ControladorNotificacion" as ctrl_notif <<control>>
    class ":SolicitudTraspaso" as ce_solicitud <<entity>>
    class ":DAOTraspaso" as ce_dao <<entity>>
    class ":BaseDeDatos" as bd_datos <<database>>

    ' ------------------------------------------------------------------ '
    ' Nivel 1: Actor y Frontera de Interacción (Sistema)                '
    ' ------------------------------------------------------------------ '
    actor_cliente -down- ui_notif : "1: DetectarCambioEstado() >\n< 2: MostrarNotificacion()"

    ui_notif -down- ctrl_notif : "3: NotificarCambioEstado(solicitudId, nuevoEstado) >\n< 4: ConfirmacionEnviada()"

    ' ------------------------------------------------------------------ '
    ' Nivel 2: Controlador y DAO                                       '
    ' ------------------------------------------------------------------ '
    ctrl_notif -right- ce_dao : "5: ObtenerSolicitudYEstado(solicitudId) >\n< DatosSolicitud\n6: ActualizarTimestampNotificacion()"

    ce_dao -down- bd_datos : "7: SELECT * FROM solicitud_traspaso WHERE id = :solicitudId"

    ' Margen derecho
    bd_datos -[hidden]right-> espaciadorDerecha

    ' ------------------------------------------------------------------ '
    ' NIVEL ALTERNATIVO: Flujos A1-A4                                  '
    ' ------------------------------------------------------------------ '
    alt A1: Destinatario no disponible
        ctrl_notif -> actor_cliente : A1-1: TokenExpirado/FueraDeLinea >\n< RegistrarIntentoReenvio()
    else A2: Solicitud ya procesada
        ctrl_notif -> actor_cliente : A2-1: NotificacionDuplicada >\n< ActualizarTimestampUltimaNotificacion()
    else A3: Permiso denegado
        ctrl_notif -> actor_cliente : A3-1: SinPermisosNotificacion >\n< RegistrarEventoPermiso()
    else A4: Fallo servicio notificaciones
        ctrl_notif -> actor_cliente : A4-1: ErrorServicio >\n< IniciarRetryExponencial()

    ' Poscondición final
    note right: Poscondición: Sin modificar inventario central\nni estado de solicitud en BD
}

@enduml